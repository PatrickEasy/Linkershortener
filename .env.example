# Copy this file to .env and edit.  .env is git-ignored.
# Real environment variables override anything set here.

# Public base URL of the site (no trailing slash).  Used for the links printed
# by `list`/`add`, the home/404 pages, and the CNAME file.
#   Project page:   https://patrickeasy.github.io/Linkershortener   (no CNAME written)
#   Custom domain:  https://go.example.com                          (CNAME written)
# Local previews via `python shortener.py serve` always run at http://localhost:8000/
# regardless of this value - the generated pages use relative paths only.
SITE_URL=https://patrickeasy.github.io/Linkershortener

# Folder the static site is generated into.  "docs" matches GitHub Pages'
# "Deploy from branch: main /docs" option.
OUTPUT_DIR=docs

# Where redirect pages POST click beacons.  Leave empty to disable tracking.
# `python shortener.py stats` GETs the same URL and expects a JSON array back.
# See README.md > Statistics for the payload contract and backend options.
STATS_ENDPOINT=

# Client-side IP geolocation API used for per-country routing.  Must return
# JSON containing a two-letter country code (country_code / country / countryCode).
# Free options: https://ipapi.co/json/ (default, ~1000 req/day free),
#               https://api.country.is/, https://ipwho.is/
GEO_API_URL=https://ipapi.co/json/

# If the geo lookup takes longer than this, redirect to the default URL.
GEO_TIMEOUT_MS=1500

# <title> shown on redirect pages unless a link sets its own --title.
SITE_TITLE=Redirecting...
